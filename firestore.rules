
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isUserProfile(data) {
      return data.uid is string &&
             data.email is string &&
             (!('displayName' in data) || data.displayName is string || data.displayName == null) &&
             (!('photoURL' in data) || data.photoURL is string || data.photoURL == null) &&
             'plan' in data && (data.plan == 'Free' || data.plan == 'Lifetime') &&
             'trialEndsAt' in data && data.trialEndsAt is number;
    }

    function isListCreate(data) {
      return data.name is string &&
             data.createdAt is number &&
             data.emailCount is number &&
             data.userId is string && data.userId == request.auth.uid &&
             data.data is list;
    }
    
    function isNewsletterSubscriber(data) {
      return data.email is string &&
             data.email.matches('.+@.+\\..+') &&
             data.subscribedAt is number;
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      
      allow create: if request.auth.uid == userId &&
                       isUserProfile(request.resource.data) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.plan == 'Free' &&
                       request.resource.data.trialEndsAt > request.time.toMillis();

      allow update: if request.auth.uid == userId && (
          // Case 1: Allow plan upgrade from Free to Lifetime.
          // This rule checks that ONLY the 'plan' field is being changed.
          (resource.data.plan == 'Free' && request.resource.data.plan == 'Lifetime' && request.resource.data.keys().hasOnly(['plan'])) ||
          
          // Case 2: Allow general profile updates (e.g., displayName, photoURL).
          // This rule ensures core fields like uid, email, plan, and trialEndsAt are NOT changed during a general update.
          (isUserProfile(request.resource.data) &&
           request.resource.data.uid == resource.data.uid &&
           request.resource.data.email == resource.data.email &&
           request.resource.data.plan == resource.data.plan &&
           request.resource.data.trialEndsAt == resource.data.trialEndsAt)
        );

      match /lists/{listId} {
        allow read, delete: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId && isListCreate(request.resource.data);
        allow update: if false;
      }
    }
     match /subscribers/{subscriberId} {
      allow create: if isNewsletterSubscriber(request.resource.data);
      allow read, update, delete: if false;
    }
  }
}
